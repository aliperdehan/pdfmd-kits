# pdfmd kit: APA 7th edition papers with the apa7 class.
#   pdfmd paper --kit apa7            student paper (the default mode)
#   pdfmd paper --kit apa7:man        professional manuscript (double-spaced, title on its own page)
#   pdfmd kits                        pdfmd --kits apa7 shows and checks this file
#
# This folder holds the class and its language files (tex/), the citation style (apa.csl) and the Lua filter
# (apa7.lua). TeX needs no apa7 package installed; the class's helper packages (fancyhdr, endfloat ...) still
# come from the TeX installation or, with Tectonic, from its bundle (Tectonic also needs
# --pdf-engine-opt=-Zsearch-path=<this folder>/tex, see ../README.md). Sources and licenses: ../THIRD_PARTY.md.
kit-format: 1
name: apa7
version: 0.1.0               # this kit's own version (the class it ships is v2.16, see ../THIRD_PARTY.md)
description: APA 7th edition papers (apa7 class, apa.csl, front-matter filter)
default-mode: stu
defaults: metadata.yaml
lua: [apa7.lua]
carry: [tex/, apa.csl]

modes:
  stu:
    aliases: [student, "student paper"]
    description: student paper, with the title-page fields course, professor and duedate
    metadata: {classoption: [stu]}
  man:
    aliases: [manuscript, professional]
    description: professional manuscript, double-spaced, author note and running head
    metadata: {classoption: [man]}
  doc:
    aliases: [document, single]
    description: a single-spaced document in APA style
    metadata: {classoption: [doc]}
  jou:
    aliases: [journal]
    description: journal-article layout (two columns, Times)
    metadata: {classoption: [jou]}
